# Copy to landing/.env for local builds. These values are public; never put secrets here.
PUBLIC_SITE_NAME=AgroShield
PUBLIC_LANDING_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_PROXY_TARGET=http://localhost:3000
PUBLIC_DEMO_MODE=true

# Leave empty until a real address exists. The placeholder example domains are hidden.
PUBLIC_SUPPORT_EMAIL=
PUBLIC_WHATSAPP_NUMBER=

# Real deployment must set a legal identity and address before publishing legal pages.
PUBLIC_LEGAL_ENTITY=AgroShield, proyecto en desarrollo
PUBLIC_LEGAL_ADDRESS=
