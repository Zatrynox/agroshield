---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoForm from '../components/DemoForm.astro';
import CoreMark from '../components/CoreMark.astro';
import {
  hasRealEmail,
  hasRealWhatsApp,
  landingUrl,
  supportEmail,
  whatsappUrl,
} from '../lib/site';

const base = Astro.site ?? new URL(landingUrl);
const canonical = new URL('/demo', base).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Solicitar una demo de AgroShield',
    description:
      'Formulario para solicitar una demostración de AgroShield con datos de ejemplo.',
    url: canonical,
    inLanguage: 'es-ES',
  },
];
---

<BaseLayout
  title="Solicitar una demo — AgroShield"
  description="Solicita una demo guiada de AgroShield: lecturas firmadas, alertas con cuenta atrás y salud del suelo. Sin compromiso y con datos de ejemplo."
  path="/demo"
  jsonLd={jsonLd}
>
  <section class="demo" aria-labelledby="demo-title">
    <div class="demo__intro on-dark">
      <div class="demo__intro-inner">
        <a class="demo__back" href="/">← Volver al inicio</a>
        <h1 id="demo-title">Solicita una demo.</h1>
        <p class="demo__lead">
          Una sesión guiada para ver si AgroShield encaja con tu explotación:
          sensores, zonas, alertas y el historial de cada decisión.
        </p>

        <div class="demo__steps">
          <div class="demo__step">
            <CoreMark />
            <div>
              <h2>Leemos tu mensaje</h2>
              <p>Usamos lo que nos cuentas para preparar la conversación, no para enviarte campañas.</p>
            </div>
          </div>
          <div class="demo__step">
            <CoreMark />
            <div>
              <h2>Acordamos una llamada</h2>
              <p>Sin compromiso. Si no encaja, lo decimos y no hay propuesta comercial.</p>
            </div>
          </div>
          <div class="demo__step">
            <CoreMark />
            <div>
              <h2>Vemos el panel</h2>
              <p>La demo usa datos de ejemplo y no mezcla información de clientes reales.</p>
            </div>
          </div>
        </div>

        <p class="demo__note">
          La demo no sustituye una prueba en campo. Las predicciones y el pronóstico
          aparecen marcados como vista de ejemplo hasta validar el modelo.
        </p>

        {(hasRealWhatsApp || hasRealEmail) && (
          <div class="demo__channels">
            <p>¿Prefieres un canal directo?</p>
            <div>
              {hasRealWhatsApp && (
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-event="whatsapp_click"
                  data-event-placement="demo-page"
                >WhatsApp ↗</a>
              )}
              {hasRealEmail && <a href={`mailto:${supportEmail}`}>{supportEmail}</a>}
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="demo__form-panel">
      <div class="demo__form-card" data-reveal>
        <h2 class="sr">Formulario de solicitud de demo</h2>
        <DemoForm tone="light" source="demo-page" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    min-height: calc(100svh - 76px);
    background: var(--as-bg);
  }

  .demo__intro {
    display: flex;
    align-items: flex-start;
    padding: clamp(36px, 5vw, 72px) var(--as-margin);
    background: var(--as-accent);
    color: var(--as-bg);
  }

  .demo__intro-inner {
    width: 100%;
    max-width: 560px;
    margin-left: auto;
  }

  .demo__back {
    display: inline-block;
    color: #d5ded1;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .demo__back:hover {
    color: var(--as-bg);
    text-decoration: underline;
  }

  .demo h1 {
    max-width: 10ch;
    margin-top: clamp(34px, 6vh, 64px);
    font-size: clamp(2.5rem, 5.4vw, 4.8rem);
    line-height: 0.93;
  }

  .demo__lead {
    max-width: 38ch;
    margin-top: 20px;
    color: #dfe6da;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .demo__steps {
    display: grid;
    gap: 24px;
    max-width: 42ch;
    margin-top: clamp(36px, 6vh, 64px);
  }

  .demo__step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .demo__step .core-mark {
    width: 14px;
    height: 24px;
    margin-top: 3px;
  }

  .demo__step h2 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .demo__step p {
    margin-top: 5px;
    color: #cbd6c8;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .demo__note {
    max-width: 44ch;
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid rgba(246, 243, 234, 0.25);
    color: #cbd6c8;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .demo__channels {
    margin-top: 22px;
    color: #cbd6c8;
    font-size: 0.875rem;
  }

  .demo__channels div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 6px;
  }

  .demo__channels a {
    color: var(--as-bg);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .demo__form-panel {
    display: flex;
    align-items: center;
    padding: clamp(32px, 5vw, 72px) var(--as-margin);
  }

  .demo__form-card {
    width: 100%;
    max-width: 620px;
    margin-right: auto;
    padding: clamp(24px, 3.4vw, 40px);
    border-radius: var(--as-radius-sm);
    background: var(--as-surface);
  }

  @media (max-width: 980px) {
    .demo {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .demo__intro {
      padding-inline: var(--as-margin);
    }

    .demo__intro-inner {
      max-width: 720px;
      margin-inline: auto;
    }

    .demo__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
      gap: 20px;
    }

    .demo__form-panel {
      padding-inline: var(--as-margin);
    }

    .demo__form-card {
      max-width: 720px;
      margin-inline: auto;
    }
  }

  @media (max-width: 720px) {
    .demo__steps {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .demo h1 {
      font-size: clamp(2.4rem, 10vw, 3.4rem);
    }

    .demo__form-card {
      padding: 22px 18px;
    }
  }
</style>
