---
import { Image } from 'astro:assets';
import LegalLayout from '../layouts/LegalLayout.astro';
import creditsData from '../assets/credits.json';
import aerialFarmland from '../assets/photos/aerial-farmland.jpg';
import soilProfile from '../assets/photos/soil-profile.jpg';
import pivotIrrigation from '../assets/photos/pivot-irrigation.jpg';
import farmerWheat from '../assets/photos/farmer-wheat.jpg';
import oliveGrove from '../assets/photos/olive-grove.jpg';
import wheatClose from '../assets/photos/wheat-close.jpg';

interface Credit {
  title: string;
  author: string;
  license: string;
  licenseUrl: string;
  sourceUrl: string;
  note: string;
  alt: string;
}

const photos = {
  'aerial-farmland.jpg': aerialFarmland,
  'soil-profile.jpg': soilProfile,
  'pivot-irrigation.jpg': pivotIrrigation,
  'farmer-wheat.jpg': farmerWheat,
  'olive-grove.jpg': oliveGrove,
  'wheat-close.jpg': wheatClose,
} as const;

const credits = Object.entries(creditsData) as Array<[keyof typeof photos, Credit]>;
---

<LegalLayout
  title="Créditos"
  description="Autoría y licencias de las fotografías y la tipografía usadas en AgroShield."
  path="/creditos"
>
  <p class="prose__lede">
    Las fotografías del sitio vienen de Wikimedia Commons y se usan con la licencia
    indicada. Las versiones publicadas se han redimensionado para la web; no se han
    añadido personas, clientes ni situaciones que no existan en el original.
  </p>

  <h2>Fotografías</h2>
  <div class="credits-grid">
    {credits.map(([file, credit]) => (
      <figure class="credit">
        <div class="credit__image">
          <Image
            src={photos[file]}
            alt={credit.alt}
            widths={[240, 360, 520]}
            sizes="(max-width: 820px) 90vw, 320px"
            loading="lazy"
            decoding="async"
            quality={76}
          />
        </div>
        <figcaption>
          <h3>{credit.title}</h3>
          <p class="credit__author">{credit.author}</p>
          <p class="credit__license">
            <a href={credit.licenseUrl} target="_blank" rel="noopener noreferrer">
              {credit.license}<span class="sr"> (abre en una pestaña nueva)</span>
            </a>
          </p>
          <p class="credit__note">{credit.note}</p>
          <p class="credit__source">
            <a href={credit.sourceUrl} target="_blank" rel="noopener noreferrer">
              Ver la ficha original en Wikimedia Commons<span class="sr"> (abre en una pestaña nueva)</span>
            </a>
          </p>
          <p class="credit__alt"><span>Texto alternativo:</span> {credit.alt}</p>
        </figcaption>
      </figure>
    ))}
  </div>

  <h2>Tipografía</h2>
  <p>
    <strong>Switzer</strong> (400, 500 y 600), de Indian Type Foundry, distribuida por
    <a href="https://www.fontshare.com/fonts/switzer" target="_blank" rel="noopener noreferrer">
      Fontshare<span class="sr"> (abre en una pestaña nueva)</span>
    </a>, bajo la licencia de Fontshare. Los archivos se sirven desde este sitio.
  </p>

  <h2>Interfaz y código</h2>
  <p>
    La interfaz, los gráficos de datos y el núcleo de suelo son piezas propias,
    construidas con HTML, CSS y SVG. Los iconos no proceden de una librería externa.
    Las fotografías no representan clientes ni instalaciones de AgroShield.
  </p>

  <h2>Licencias de las versiones adaptadas</h2>
  <p>
    Las imágenes con licencia CC BY o CC BY-SA se distribuyen aquí bajo la misma
    licencia que el original, con la atribución de esta página. Las imágenes CC0 y de
    dominio público no exigen atribución, pero se acreditan igualmente.
  </p>
</LegalLayout>

<style>
  .credits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 20px;
    margin-block: 28px 48px;
  }

  .credit {
    margin: 0;
  }

  .credit__image {
    overflow: hidden;
    border-radius: var(--as-radius-sm);
    background: var(--as-surface);
    aspect-ratio: 4 / 3;
  }

  .credit__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .credit figcaption {
    margin-top: 12px;
  }

  .credit h3 {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .credit p {
    margin-top: 4px;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .credit__author {
    color: var(--as-muted);
  }

  .credit__license a,
  .credit__source a {
    color: var(--as-data);
    font-weight: 500;
  }

  .credit__alt {
    color: var(--as-muted);
  }

  .credit__alt span {
    font-weight: 500;
  }

  @media (max-width: 620px) {
    .credits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
