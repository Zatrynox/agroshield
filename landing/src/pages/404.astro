---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoreMark from '../components/CoreMark.astro';
---

<BaseLayout
  title="Página no encontrada — AgroShield"
  description="La página que buscas no existe. Vuelve al inicio o solicita una demo de AgroShield."
  path="/404"
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container not-found__inner">
      <div class="not-found__mark" aria-hidden="true">
        <CoreMark />
      </div>
      <h1 id="not-found-title">Esta página no existe.</h1>
      <p>
        Puede que el enlace esté mal escrito o que la página haya cambiado. El
        producto sigue en el inicio, y la demo también.
      </p>
      <div class="not-found__actions">
        <a class="button" href="/">Volver al inicio</a>
        <a class="text-link" href="/demo">Solicitar una demo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: calc(100svh - 76px);
    padding-block: 80px;
  }

  .not-found__inner {
    max-width: 700px;
  }

  .not-found__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin-bottom: 32px;
    background: var(--as-accent);
  }

  .not-found__mark .core-mark {
    width: 18px;
    height: 30px;
  }

  .not-found h1 {
    max-width: 12ch;
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .not-found p {
    max-width: 42ch;
    margin-top: 20px;
    color: var(--as-muted);
    font-size: var(--as-step-lead);
    line-height: 1.45;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    margin-top: 32px;
  }

  @media (max-width: 680px) {
    .not-found__actions {
      display: grid;
      gap: 14px;
    }

    .not-found__actions .button {
      width: 100%;
    }
  }
</style>
