---
import CoreMark from './CoreMark.astro';

const stages = ['Lectura', 'Riesgo', 'Alerta', 'Acción'];
---

<section class="hiw" id="como-funciona" aria-labelledby="hiw-clause" data-how>
  <div class="hiw__copy">
    <h2 class="hiw__clause" id="hiw-clause" aria-live="polite">
      <span data-clause>Primero,<br />la firma.</span>
      <span data-clause hidden>Después,<br />el riesgo.</span>
      <span data-clause hidden>Entonces,<br />la alerta.</span>
      <span data-clause hidden>Al final,<br />la acción.</span>
    </h2>
    <p class="hiw__support">
      La misma lectura recorre cuatro estados hasta convertirse en una decisión registrada.
    </p>
    <p class="hiw__hint">Desliza o usa las flechas para recorrer la traza.</p>
  </div>

  <div class="hiw__media">
    <div class="hiw__fragment" data-ui>
      <article class="hiw-card" data-stage-panel>
        <div class="hiw-card__top">
          <span class="demo-tag">Vista de ejemplo</span>
          <span class="hiw-card__time">06:12</span>
        </div>
        <p class="hiw-card__label">Lectura recibida</p>
        <h3>Sensor S-04 · Olivos</h3>
        <dl class="hiw-card__data">
          <div><dt>Humedad</dt><dd>18,4 %</dd></div>
          <div><dt>Temperatura</dt><dd>31,2 °C</dd></div>
          <div><dt>Batería</dt><dd>87 %</dd></div>
          <div><dt>Señal</dt><dd>Buena</dd></div>
        </dl>
        <p class="hiw-card__check"><span aria-hidden="true"></span>Firma Ed25519 verificada</p>
        <p class="hiw-card__foot">ID de lectura · 7f3a…9c21</p>
      </article>

      <article class="hiw-card" data-stage-panel hidden>
        <div class="hiw-card__top">
          <span class="demo-tag">Vista de ejemplo</span>
          <span class="hiw-card__time">06:12</span>
        </div>
        <p class="hiw-card__label">Cálculo de riesgo</p>
        <div class="hiw-card__score">
          <CoreMark label="Núcleo de suelo" />
          <div>
            <span>Salud del suelo</span>
            <strong>42 <small>/ 100</small></strong>
          </div>
        </div>
        <dl class="hiw-card__data hiw-card__data--two">
          <div><dt>Factor limitante</dt><dd>Materia orgánica</dd></div>
          <div><dt>Días de margen</dt><dd>2,6</dd></div>
        </dl>
        <p class="hiw-card__rule">Regla: humedad &lt; 20 % en floración</p>
        <p class="hiw-card__foot">Pronóstico marcado como vista de ejemplo</p>
      </article>

      <article class="hiw-card" data-stage-panel hidden>
        <div class="hiw-card__top">
          <span class="demo-tag">Vista de ejemplo</span>
          <span class="hiw-card__time">06:14</span>
        </div>
        <p class="hiw-card__label">Alerta creada</p>
        <h3>Estrés hídrico en floración</h3>
        <p class="hiw-card__count">02 d 14 h <span>hasta el límite</span></p>
        <p class="hiw-card__recommendation">
          Riego corto al atardecer. Vuelve a medir humedad a las 06:00.
        </p>
        <p class="hiw-card__foot">Severidad alta · zona Sector 4</p>
      </article>

      <article class="hiw-card" data-stage-panel hidden>
        <div class="hiw-card__top">
          <span class="demo-tag">Vista de ejemplo</span>
          <span class="hiw-card__time">06:20</span>
        </div>
        <p class="hiw-card__label">Intervención registrada</p>
        <h3>Alerta reconocida</h3>
        <dl class="hiw-card__data">
          <div><dt>Responsable</dt><dd>Cuenta demo</dd></div>
          <div><dt>Acción</dt><dd>Riego corto · 22:30</dd></div>
        </dl>
        <p class="hiw-card__check hiw-card__check--green"><span aria-hidden="true"></span>Queda en el historial</p>
        <p class="hiw-card__foot">No se borra el aviso original</p>
      </article>
    </div>
  </div>

  <div class="hiw__control">
    <label class="sr" for="hiw-range">Etapa del recorrido</label>
    <div class="hiw__track-wrap">
      <div class="hiw__track" aria-hidden="true"><span class="hiw__fill" data-hiw-fill></span></div>
      <input
        class="hiw__range"
        id="hiw-range"
        type="range"
        min="0"
        max="3"
        step="1"
        value="0"
        aria-valuetext="Lectura"
        data-hiw-range
      />
    </div>
    <div class="hiw__stages">
      {stages.map((stage, index) => (
        <button
          class="hiw__stage"
          type="button"
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-hiw-button={index}
        >{stage}</button>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-how]');
  if (root) {
    const range = root.querySelector<HTMLInputElement>('[data-hiw-range]');
    const fill = root.querySelector<HTMLElement>('[data-hiw-fill]');
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const clauses = Array.from(root.querySelectorAll<HTMLElement>('[data-clause]'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hiw-button]'));
    const names = ['Lectura', 'Riesgo', 'Alerta', 'Acción'];

    const show = (rawIndex: number): void => {
      const index = Math.max(0, Math.min(3, Number.isFinite(rawIndex) ? rawIndex : 0));
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
      clauses.forEach((clause, clauseIndex) => {
        clause.hidden = clauseIndex !== index;
      });
      buttons.forEach((button, buttonIndex) => {
        button.setAttribute('aria-pressed', String(buttonIndex === index));
      });
      if (range) {
        range.value = String(index);
        range.setAttribute('aria-valuetext', names[index] ?? names[0]!);
      }
      if (fill) fill.style.width = `${(index / 3) * 100}%`;
    };

    range?.addEventListener('input', () => show(Number(range.value)));
    buttons.forEach((button) => {
      button.addEventListener('click', () => show(Number(button.dataset.hiwButton)));
    });

    show(0);
  }
</script>

<style>
  .hiw {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(88svh, 860px);
    border-top: 0;
  }

  .hiw__copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(40px, 5vw, 64px) clamp(24px, 4vw, 56px) 160px;
    background: var(--as-bg);
  }

  .hiw__clause {
    max-width: 11ch;
    font-size: clamp(2.5rem, 4.6vw, 4.75rem);
    line-height: 0.94;
  }

  .hiw__clause span[hidden] {
    display: none;
  }

  .hiw__support {
    max-width: 32ch;
    margin-top: auto;
    padding-top: 36px;
    color: var(--as-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .hiw__hint {
    margin-top: 10px;
    color: var(--as-muted);
    font-size: 0.8125rem;
  }

  .hiw__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px 150px;
    overflow: hidden;
    background: var(--as-accent);
  }

  .hiw__fragment {
    width: 440px;
    max-width: none;
  }

  .hiw-card {
    min-height: 338px;
    padding: 20px;
    border-radius: var(--as-radius-sm);
    background: #fbf9f1;
    color: var(--as-ink);
    font-size: 0.875rem;
    line-height: 1.4;
    animation: panel-in 220ms var(--as-ease-out) both;
  }

  .hiw-card[hidden] {
    display: none;
  }

  .hiw-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hiw-card__time {
    color: var(--as-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .hiw-card__label {
    margin-top: 22px;
    color: var(--as-muted);
    font-size: 0.8125rem;
  }

  .hiw-card h3 {
    max-width: 17ch;
    margin-top: 5px;
    font-size: 1.5rem;
    line-height: 1.03;
  }

  .hiw-card__data {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 20px;
    list-style: none;
  }

  .hiw-card__data div {
    padding: 10px 0;
    border-top: 1px solid #e2dbcb;
  }

  .hiw-card__data dt {
    color: var(--as-muted);
    font-size: 0.8125rem;
  }

  .hiw-card__data dd {
    margin: 2px 0 0;
    font-size: 1rem;
    font-weight: 500;
  }

  .hiw-card__data--two {
    grid-template-columns: 1fr;
    margin-top: 16px;
  }

  .hiw-card__check {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    color: var(--as-success);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .hiw-card__check span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--as-success);
  }

  .hiw-card__check--green {
    color: var(--as-success);
  }

  .hiw-card__foot {
    margin-top: 14px;
    color: var(--as-muted);
    font-size: 0.8125rem;
  }

  .hiw-card__score {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 18px;
  }

  .hiw-card__score .core-mark {
    width: 26px;
    height: 44px;
  }

  .hiw-card__score span {
    display: block;
    color: var(--as-muted);
    font-size: 0.8125rem;
  }

  .hiw-card__score strong {
    display: block;
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .hiw-card__score small {
    color: var(--as-muted);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .hiw-card__rule {
    margin-top: 16px;
    padding: 10px 12px;
    border-radius: var(--as-radius-sm);
    background: var(--as-surface);
    color: var(--as-muted);
    font-size: 0.8125rem;
  }

  .hiw-card__count {
    margin-top: 18px;
    font-size: 2.4rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .hiw-card__count span {
    display: block;
    margin-top: 5px;
    color: var(--as-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .hiw-card__recommendation {
    margin-top: 18px;
    padding: 12px 14px;
    border-radius: var(--as-radius-sm);
    background: var(--as-surface);
    font-size: 0.9375rem;
  }

  .hiw__control {
    position: absolute;
    right: var(--as-margin);
    bottom: 24px;
    left: var(--as-margin);
    z-index: 2;
    padding: 13px 20px 12px;
    border-radius: var(--as-radius-sm);
    background: var(--as-bg);
  }

  .hiw__track-wrap {
    position: relative;
    height: 44px;
  }

  .hiw__track {
    position: absolute;
    top: 50%;
    right: 16px;
    left: 16px;
    height: 8px;
    background: var(--as-surface-strong);
    transform: translateY(-50%);
  }

  .hiw__fill {
    display: block;
    width: 0;
    height: 100%;
    background: var(--as-ink);
    transition: width var(--as-base) var(--as-ease-out);
  }

  .hiw__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 44px;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: grab;
  }

  .hiw__range:active {
    cursor: grabbing;
  }

  .hiw__range::-webkit-slider-runnable-track {
    height: 8px;
    background: transparent;
  }

  .hiw__range::-webkit-slider-thumb {
    width: 32px;
    height: 32px;
    margin-top: -12px;
    border: 0;
    border-radius: 2px;
    appearance: none;
    background: var(--as-accent);
  }

  .hiw__range::-moz-range-track {
    height: 8px;
    background: transparent;
  }

  .hiw__range::-moz-range-thumb {
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 2px;
    background: var(--as-accent);
  }

  .hiw__range:focus-visible {
    outline-offset: 2px;
  }

  .hiw__stages {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 2px;
  }

  .hiw__stage {
    padding: 4px 0;
    border: 0;
    background: transparent;
    color: var(--as-muted);
    font-size: 0.9375rem;
    text-align: left;
  }

  .hiw__stage[aria-pressed='true'] {
    color: var(--as-ink);
    font-weight: 600;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 980px) {
    .hiw__copy {
      padding-bottom: 150px;
    }

    .hiw__clause {
      font-size: clamp(2.2rem, 5vw, 3.4rem);
    }

    .hiw__media {
      padding-bottom: 140px;
    }
  }

  @media (max-width: 820px) {
    .hiw {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hiw__media {
      order: 1;
      height: 46svh;
      min-height: 330px;
      padding: 20px 20px 20px;
      justify-content: flex-start;
      align-items: flex-start;
    }

    .hiw__fragment {
      width: 440px;
    }

    .hiw-card {
      min-height: 0;
    }

    .hiw__control {
      position: static;
      order: 2;
      margin: -1px 0 0;
      padding: 12px var(--as-margin) 14px;
      background: var(--as-bg);
    }

    .hiw__copy {
      order: 3;
      padding: 28px var(--as-margin) 56px;
    }

    .hiw__clause {
      max-width: 14ch;
      font-size: clamp(2.35rem, 9vw, 4rem);
    }

    .hiw__support {
      margin-top: 26px;
      padding-top: 0;
      font-size: 1rem;
    }

    .hiw__stages {
      grid-template-columns: 1fr 1fr;
      gap: 6px 12px;
    }

    .hiw__stage {
      min-height: 40px;
      padding: 8px 0;
      font-size: 0.9375rem;
    }

    .hiw__track-wrap {
      height: 48px;
    }

    .hiw__range {
      height: 48px;
    }

    .hiw__range::-webkit-slider-thumb {
      width: 40px;
      height: 40px;
      margin-top: -16px;
    }

    .hiw__range::-moz-range-thumb {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 380px) {
    .hiw__media {
      min-height: 300px;
    }

    .hiw-card h3 {
      font-size: 1.3rem;
    }
  }
</style>
