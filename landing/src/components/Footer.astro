---
import CoreMark from './CoreMark.astro';
import {
  appUrl,
  currentYear,
  demoMode,
  hasRealEmail,
  hasRealWhatsApp,
  legalEntity,
  supportEmail,
  whatsappUrl,
} from '../lib/site';
---

<footer class="site-footer on-dark" id="pie">
  <div class="site-footer__motif" aria-hidden="true">
    <span class="core-mark">
      <span class="core-mark__band"></span>
      <span class="core-mark__band"></span>
      <span class="core-mark__band"></span>
      <span class="core-mark__band"></span>
      <span class="core-mark__band"></span>
      <span class="core-mark__band"></span>
      <span class="core-mark__band"></span>
    </span>
  </div>

  <div class="container site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__wordmark" href="/" aria-label="AgroShield, volver al inicio">
          <CoreMark />
          <span>AgroShield</span>
        </a>
        <p>
          Lecturas de suelo firmadas, alertas con cuenta atrás y una recomendación
          concreta para actuar antes del límite.
        </p>
        <a
          class="button button--light site-footer__cta"
          href="/demo"
          data-event="cta_demo_click"
          data-event-placement="footer"
        >Solicitar una demo</a>
      </div>

      <nav class="site-footer__col" aria-label="Producto">
        <h2 class="site-footer__title">Producto</h2>
        <ul>
          <li><a href="/#como-funciona">Cómo funciona</a></li>
          <li><a href="/#capacidades">Capacidades</a></li>
          <li><a href="/#preguntas">Preguntas</a></li>
          <li>
            <a
              href={appUrl}
              data-session-link
              data-event="login_click"
              data-event-placement="footer"
            >Iniciar sesión</a>
          </li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Legal">
        <h2 class="site-footer__title">Legal</h2>
        <ul>
          <li><a href="/privacidad">Privacidad</a></li>
          <li><a href="/terminos">Términos</a></li>
          <li><a href="/cookies">Cookies</a></li>
          <li><a href="/creditos">Créditos</a></li>
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Contacto</h2>
        <ul>
          <li><a href="/demo">Solicitar una demo</a></li>
          {hasRealWhatsApp && (
            <li>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-event="whatsapp_click"
                data-event-placement="footer"
              >WhatsApp</a>
            </li>
          )}
          {hasRealEmail && <li><a href={`mailto:${supportEmail}`}>{supportEmail}</a></li>}
          {!hasRealEmail && !hasRealWhatsApp && (
            <li class="site-footer__note">Escríbenos desde el formulario de demo.</li>
          )}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {currentYear} AgroShield</p>
      <p class="site-footer__status">
        {demoMode ? 'Modo demo local · sin datos de clientes' : legalEntity}
      </p>
      <p><a href="/creditos">Fotografías y créditos</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: clamp(56px, 7vw, 96px) 28px;
    overflow: hidden;
    background: var(--as-ink);
    color: var(--as-bg);
  }

  .site-footer__motif {
    position: absolute;
    right: max(2vw, 20px);
    bottom: -40px;
    width: 180px;
    height: 330px;
    opacity: 0.32;
    transform: rotate(12deg);
    pointer-events: none;
  }

  .site-footer__motif .core-mark {
    width: 100%;
    height: 100%;
  }

  .site-footer__inner {
    position: relative;
    z-index: 1;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) repeat(3, minmax(0, 0.8fr));
    gap: clamp(32px, 5vw, 72px);
  }

  .site-footer__brand {
    max-width: 340px;
  }

  .site-footer__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--as-bg);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .site-footer__brand p {
    margin-top: 18px;
    color: #c9cdc2;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .site-footer__cta {
    margin-top: 26px;
  }

  .site-footer__title {
    margin-bottom: 18px;
    color: #9ea695;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .site-footer__col ul {
    display: grid;
    gap: 11px;
    list-style: none;
  }

  .site-footer__col a {
    color: var(--as-bg);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .site-footer__col a:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .site-footer__note {
    max-width: 20ch;
    color: #c9cdc2;
    font-size: 0.9375rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 28px;
    margin-top: clamp(56px, 7vw, 96px);
    color: #9ea695;
    font-size: 0.8125rem;
  }

  .site-footer__bottom a {
    color: #c9cdc2;
    text-decoration: none;
  }

  .site-footer__bottom a:hover {
    color: var(--as-bg);
    text-decoration: underline;
  }

  .site-footer__status {
    color: #c9cdc2;
  }

  @media (max-width: 900px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
      max-width: 420px;
    }
  }

  @media (max-width: 560px) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .site-footer__motif {
      right: -50px;
      opacity: 0.22;
    }

    .site-footer__bottom {
      display: grid;
      gap: 8px;
      margin-top: 56px;
    }
  }
</style>
