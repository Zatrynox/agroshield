---
import BaseLayout from '../layouts/BaseLayout.astro';
import { landingUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  updated?: string;
}

const { title, description, path, updated = '26 de octubre de 2026' } = Astro.props;
const base = Astro.site ?? new URL(landingUrl);
const canonical = new URL(path, base).href;

const documents = [
  { href: '/privacidad', label: 'Privacidad' },
  { href: '/terminos', label: 'Términos' },
  { href: '/cookies', label: 'Cookies' },
  { href: '/creditos', label: 'Créditos' },
];

const currentPath = Astro.url.pathname;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    inLanguage: 'es-ES',
    isPartOf: {
      '@type': 'WebSite',
      name: 'AgroShield',
      url: base.href,
    },
  },
];
---

<BaseLayout title={`${title} — AgroShield`} description={description} path={path} jsonLd={jsonLd}>
  <div class="legal">
    <div class="container legal__grid">
      <aside class="legal__aside">
        <a class="legal__back" href="/">← Volver al inicio</a>
        <nav class="legal__nav" aria-label="Documentos legales">
          {documents.map((doc) => (
            <a
              href={doc.href}
              aria-current={currentPath === doc.href ? 'page' : undefined}
            >{doc.label}</a>
          ))}
        </nav>
      </aside>

      <article class="legal__main prose">
        <h1>{title}</h1>
        <p class="prose__meta">Última actualización: {updated}</p>
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(48px, 7vw, 88px) clamp(72px, 9vw, 120px);
    background: var(--as-bg);
  }

  .legal__grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(36px, 7vw, 104px);
    align-items: start;
  }

  .legal__aside {
    position: sticky;
    top: 108px;
  }

  .legal__back {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--as-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .legal__back:hover {
    color: var(--as-ink);
    text-decoration: underline;
  }

  .legal__nav {
    display: grid;
    gap: 10px;
  }

  .legal__nav a {
    color: var(--as-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .legal__nav a:hover {
    color: var(--as-ink);
  }

  .legal__nav a[aria-current='page'] {
    color: var(--as-ink);
    font-weight: 600;
  }

  .legal__main {
    max-width: 720px;
    margin-inline: 0;
    padding-block: 0;
  }

  .legal__main h1 {
    font-size: clamp(2.4rem, 4.6vw, 3.8rem);
    line-height: 0.96;
  }

  @media (max-width: 820px) {
    .legal__grid {
      display: block;
    }

    .legal__aside {
      position: static;
      margin-bottom: 40px;
    }

    .legal__back {
      margin-bottom: 20px;
    }

    .legal__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 20px;
    }

    .legal__main {
      max-width: 100%;
    }
  }
</style>
